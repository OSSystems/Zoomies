+/* Zoomies: an output lights up with the sky already drawn. Without a buffer,
+ * wlroots lights it up black and the sky follows one frame later; on a busy
+ * machine that draws without a GPU, that is a black screen of a second or
+ * more between the boot splash and the greeter. The layout knows only the
+ * current mode, so the sky is painted for the pending one. If drawing fails,
+ * the output still lights up, black, as it does without this patch. */
+static void
+output_commit_drawn(struct cg_output *output, const struct wlr_output_state *state)
+{
+	output_layout_add_auto(output);
+	paint_sky(output->server, output, state);
+
+	struct wlr_output_state drawn;
+	wlr_output_state_init(&drawn);
+	bool ok = wlr_output_state_copy(&drawn, state) &&
+		  wlr_scene_output_build_state(output->scene_output, &drawn, NULL) &&
+		  wlr_output_commit_state(output->wlr_output, &drawn);
+	wlr_output_state_finish(&drawn);
+
+	if (!ok && !wlr_output_commit_state(output->wlr_output, state)) {
+		output_layout_remove(output);
+	}
+}
