+/* Zoomies: at power off and restart, the splash takes the screen from cage
+ * without the black console showing in between. Once it stops, cage keeps
+ * its last frame, the bare sky the shell faded to, while the hook named by
+ * ZOOMIES_HANDOVER waits for the splash to load and take the screen over in
+ * place. The hook returns at once when nobody asked for a power off, so
+ * logging out is not held up. */
+static void
+hand_over_screen(void)
+{
+	const char *hook = getenv("ZOOMIES_HANDOVER");
+	if (hook == NULL) {
+		return;
+	}
+	pid_t pid = fork();
+	if (pid == 0) {
+		/* The event loop blocks the signals it reads. */
+		sigset_t none;
+		sigemptyset(&none);
+		sigprocmask(SIG_SETMASK, &none, NULL);
+		execl(hook, hook, (char *) NULL);
+		_exit(127);
+	}
+	if (pid > 0) {
+		waitpid(pid, NULL, 0);
+	}
+}
+
