+/* Zoomies: the screen changes hands without a black frame. Once cage
+ * stops, the hook named by ZOOMIES_HANDOVER gets cage's handle on the screen
+ * as ZOOMIES_SCREEN_FD. At power off and restart, cage keeps showing its last
+ * frame, the bare sky the shell faded to, while the hook waits for the
+ * splash to take the screen over in place. Otherwise the hook leaves that
+ * handle open in the background until the next session has drawn: the
+ * kernel turns the screen off when the last handle on a frame closes, and
+ * would do so between two sessions. */
+static void
+hand_over_screen(struct cg_server *server)
+{
+	const char *hook = getenv("ZOOMIES_HANDOVER");
+	if (hook == NULL) {
+		return;
+	}
+	int screen = wlr_backend_get_drm_fd(server->backend);
+	pid_t pid = fork();
+	if (pid == 0) {
+		/* The session's stop signals every process in it, including one
+		 * forked while the signals go out; the hook's waits are bounded.
+		 * Ignored before the event loop's blocking is lifted, so none is
+		 * delivered in between. */
+		signal(SIGTERM, SIG_IGN);
+		signal(SIGHUP, SIG_IGN);
+		signal(SIGINT, SIG_IGN);
+		sigset_t none;
+		sigemptyset(&none);
+		sigprocmask(SIG_SETMASK, &none, NULL);
+		if (screen >= 0 && fcntl(screen, F_SETFD, 0) == 0) {
+			char number[16];
+			snprintf(number, sizeof(number), "%d", screen);
+			setenv("ZOOMIES_SCREEN_FD", number, 1);
+		}
+		execl(hook, hook, (char *) NULL);
+		_exit(127);
+	}
+	if (pid > 0) {
+		waitpid(pid, NULL, 0);
+	}
+}
